# Local SQLite file. In Docker this points at the mounted volume.
DATABASE_URL="file:./cadence.db"

# real — the 253 named artists, with photos, biographies and catalogues
#        fetched from Wikipedia and MusicBrainz. Default. For private use.
# demo — generated names, no real people, no outbound requests at all.
#        Use this anywhere the app is publicly reachable.
ROSTER_MODE="real"

# Optional. Unused by default: photos, biographies and catalogues come from
# Wikipedia and MusicBrainz, which need no credentials.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
